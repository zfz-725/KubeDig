define(`allow_common_network_operation', `
    allow $1 $1:node { kdig_node_permissions };
    allow $1 $1:netif { kdig_netif_permissions };
    allow $1 $1:socket { kdig_socket_permissions };
    allow $1 $1:packet_socket { kdig_packet_socket_permissions };
    allow $1 $1:tun_socket { kdig_tun_socket_permissions };
    allow $1 $1:unix_stream_socket { kdig_unix_stream_socket_permissions };
    allow $1 $1:unix_dgram_socket { kdig_unix_dgram_socket_permissions };
    allow $1 $1:netlink_socket { kdig_netlink_socket_permissions };
    allow $1 $1:netlink_route_socket { kdig_netlink_route_socket_permissions };

    require {
        type net_conf_t;
    }

    allow $1 net_conf_t:file { read open getattr };
')

