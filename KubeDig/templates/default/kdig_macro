
# kdig macros

define(`configure_domain', `
    require {
        role unconfined_r;
    }

    application_domain($1, $2)
    role unconfined_r types $1;

    unconfined_domtrans_to($1, $2)
    #permissive $1;

    allow $1 $1:capability { kdig_capability_permissions };
    allow $1 $1:capability2 { kdig_capability2_permissions };
')

# kdig_process_execution -> kdig_file_permissions
define(`kdig_process_execution', `{ kdig_file_permissions map }')

# kdig_no_process_execution -> kdig_file_permissions - execute
define(`kdig_no_process_execution', `{ append create getattr ioctl link lock mounton quotaon read relabelfrom relabelto rename setattr swapon unlink write audit_access entrypoint execute_no_trans execmod open map }')

define(`allow_process_execution', `
    allow $1 $1:process { setpgid setcap };
    allow $1 $2:file { kdig_process_execution };
')

define(`allow_child_process_execution', `
    require {
        type fs_t;
    }

    allow $1 $2:file { kdig_process_execution };
    allow $2 fs_t:filesystem { associate };
')

define(`allow_no_child_process_execution', `
    require {
        type fs_t;
    }

    allow $1 $2:file { kdig_no_process_execution };
    allow $2 fs_t:filesystem { associate };
')

